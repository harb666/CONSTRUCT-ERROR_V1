## Linear sample of a motion curve at `t` seconds into its clip.
static func sample(curve: Array, t: float) -> float:
	if curve.is_empty():
		return 0.0
	var f := clampf(t * RATE, 0.0, curve.size() - 1.0)
	var i := int(f)
	if i >= curve.size() - 1:
		return curve[curve.size() - 1]
	return lerpf(curve[i], curve[i + 1], f - i)
